OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5-mini

DATA_AGENT_MYSQL_NAME=local mysql
DATA_AGENT_MYSQL_HOST=127.0.0.1
DATA_AGENT_MYSQL_PORT=3306
DATA_AGENT_MYSQL_DATABASE=analytics
DATA_AGENT_MYSQL_USERNAME=reader
DATA_AGENT_MYSQL_PASSWORD=

# Python execution backend. Keep disabled by default; use local for development analysis runs.
DATA_AGENT_SANDBOX_BACKEND=disabled
# 로컬 sandbox에서 사용할 고정 Python 경로입니다.
# pandas/matplotlib/seaborn 등 분석 패키지가 미리 설치된 Python을 지정하세요.
# Windows 예: DATA_AGENT_LOCAL_PYTHON_EXECUTABLE=C:\Users\User\OneDrive\바탕 화면\Backend\.venv\Scripts\python.exe
DATA_AGENT_LOCAL_PYTHON_EXECUTABLE=
